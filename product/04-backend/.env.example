# AKS backend ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldurun.
# Hiçbiri zorunlu değil: boşsa demo yerel SQLite + bellek-içi cache ile çalışır.

# --- LLM (opsiyonel — hiçbiri yoksa deterministik kural motoru çalışır) ---
# §3b Phase 7/7.5: tercih edilen yol — tool-calling agent (danisman_llm.py).
# TODO (execution.md): PO tarafından eklenip canlı uçtan uca test edilecek.
ANTHROPIC_API_KEY=
# Eski, opsiyonel zenginleştirme yolu (asistan.py) — ANTHROPIC_API_KEY boşsa denenir.
GEMINI_API_KEY=

# --- Sahiplik/telefon doğrulama (opsiyonel — boşsa SECRET_KEY'e düşer) ---
AKS_PEPPER=

# --- Supabase (Postgres) — boşsa yerel SQLite ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis — boşsa yerel bellek cache ---
REDIS_URL=

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Veri / model yolu (opsiyonel override) ---
AKS_DATA_DIR=
AKS_MODEL=
